{
  "name": "auto_favicon_gen",
  "version": "0.1.0",
  "description": "Generate favicon if it doesn't exist",
  "main": "",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "zip": "yarn build && mkdir -p storage && rm -f storage/extension.zip && cd dist && zip -r -FS ../storage/extension.zip .",
    "lint": "eslint ./app/scripts --ext .ts --cache --format 'node_modules/eslint-formatter-friendly'",
    "lint:fix": "yarn lint --fix",
    "archive": "git archive HEAD -o storage/source.zip",
    "type-check": "tsc",
    "preinstall": "typesync || :"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.127",
    "@types/eslint": "^7.2.3",
    "@types/eslint-plugin-prettier": "^3.1.0",
    "@types/prettier": "^2.1.1",
    "@typescript-eslint/eslint-plugin": "^4.4.0",
    "@typescript-eslint/parser": "^4.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^7.10.0",
    "eslint-config-prettier": "^7.1.0",
    "eslint-formatter-friendly": "^7.0.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.1.4",
    "prettier": "^2.1.2",
    "typescript": "^4.0.3",
    "typesync": "^0.8.0"
  },
  "engines": {
    "node": ">=18",
    "yarn": "^1.18.0"
  }
}
